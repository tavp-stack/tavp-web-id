{
    "name": "tavp/web-id",
    "description": "tavp.web.id — the official TAVP website, built on TAVP CMS (dogfooding).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "tavp/core": "^0.1",
        "tavp/cms": "^0.5",
        "tavp/analytics": "^0.0",
        "tavp/tavpid": "^0.0",
        "tavp/tavphub": "^0.1",
        "league/commonmark": "^2.8",
        "tavp/tavpblocks": "^0.0"
    },
    "require-dev": {
        "tavp/cli": "^0.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/tavp-stack/tavp-core.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/tavp-stack/tavp-cms.git"
        }
    ],
    "config": {
        "allow-plugins": {}
    }
}
