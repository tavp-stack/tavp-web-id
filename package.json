{
  "scripts": {
    "build:css": "tailwindcss -i resources/css/app.css -o public/assets/app.css --minify",
    "build:css:admin": "tailwindcss -c tailwind.admin.config.js -i resources/css/admin.css -o public/assets/admin.css --minify",
    "watch:css": "tailwindcss -i resources/css/app.css -o public/assets/app.css --watch",
    "watch:css:admin": "tailwindcss -c tailwind.admin.config.js -i resources/css/admin.css -o public/assets/admin.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "tailwindcss": "^3.4.19"
  }
}
